# =============================================================================
# Cognitest Backend — Environment Variables
# Copy this file to .env and fill in real values.
# Lines marked REQUIRED have no working default and will cause startup to fail
# if left unset. Lines marked OPTIONAL have a sensible default shown.
# Never commit real secrets to source control.
# =============================================================================


# ── Server ────────────────────────────────────────────────────────────────────

# Port the uvicorn server listens on. OPTIONAL (default: 5000)
PORT=5000

# Runtime environment. Controls reload mode, docs visibility, and production
# safety checks. OPTIONAL (default: development)
# Accepted values: development | staging | production
NODE_ENV=development


# ── Database ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string used by Prisma at runtime. REQUIRED
DATABASE_URL="postgresql://user:password@localhost:5432/cognitest?sslmode=require"

# Direct (non-pooled) connection used by Prisma Migrate. REQUIRED
DIRECT_URL="postgresql://user:password@localhost:5432/cognitest?sslmode=require"


# ── JWT ───────────────────────────────────────────────────────────────────────

# Secret key used to sign and verify JWTs. REQUIRED — use a long random string.
JWT_SECRET=replace-with-a-long-random-secret

# Algorithm used for JWTs. OPTIONAL (default: HS256)
JWT_ALGORITHM=HS256

# Token lifetime in days. OPTIONAL (default: 7)
JWT_EXPIRATION_DAYS=7


# ── CORS ──────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed frontend origins. OPTIONAL
# (default: http://localhost:5173,http://127.0.0.1:5173)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174


# ── Gateway / Proxy ───────────────────────────────────────────────────────────

# URL of the downstream service the /gateway proxy forwards requests to.
# OPTIONAL (default: http://localhost:6000)
TARGET_SERVICE_URL=http://localhost:6000


# ── Super Admin ───────────────────────────────────────────────────────────────
# These two variables have NO defaults and MUST be set.
# In NODE_ENV=production the app will refuse to start if they are missing,
# empty, or match known insecure placeholder values.

# Email address of the super-admin account. REQUIRED
SUPER_ADMIN_EMAIL=admin@yourcompany.com

# Bcrypt hash of the super-admin password. REQUIRED
# Generate with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
SUPER_ADMIN_PASSWORD_HASH=<bcrypt-hash-of-your-admin-password>


# ── AI / LLM ──────────────────────────────────────────────────────────────────

# Anthropic API key for Claude-powered test generation. OPTIONAL
# (AI generation is silently skipped when this is unset.)
ANTHROPIC_API_KEY=sk-ant-...



# NOTE: LLM_API_KEY is declared in settings.py but is not read by any code.
# It is kept in the settings model for forward compatibility but has no effect.
# You do not need to set it.
# LLM_API_KEY=


# ── Redis (ARQ task queue) ────────────────────────────────────────────────────

# Redis connection URL for the ARQ background worker queue.
# Required for AI generation jobs (use_ai=true). OPTIONAL for rule-based runs.
# (default: redis://localhost:6379)
REDIS_URL=redis://localhost:6379


# ── SMTP ─────────────────────────────────────────────────────────────────────

# SMTP server hostname for outbound OTP / notification emails. OPTIONAL
# (default: smtp.gmail.com)
SMTP_SERVER=smtp.gmail.com

# SMTP port. OPTIONAL (default: 587)
SMTP_PORT=587

# SMTP login username (usually the sender email address). OPTIONAL
SMTP_USERNAME=your-email@example.com

# SMTP login password or app-specific password. OPTIONAL
SMTP_PASSWORD=your-smtp-password
